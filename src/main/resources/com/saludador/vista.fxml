<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.saludador.controlador.Controlador"
      style="-fx-background-color: #f4f7fb;">
    <padding>
        <Insets bottom="32.0" left="40.0" right="40.0" top="32.0"/>
    </padding>

    <Label text="Sistema saludador">
        <font>
            <Font name="System Bold" size="22.0"/>
        </font>
    </Label>

    <Label text="Haz clic en el botón para ingresar tus datos, la hora exacta y recibir un saludo."
           wrapText="true"
           style="-fx-text-alignment: center;"/>

    <Button fx:id="btnSolicitarSaludo"
            text="Solicitar saludo"
            defaultButton="true"
            onAction="#solicitarSaludo"
            prefWidth="180.0"
            prefHeight="36.0"/>

    <Label fx:id="lblResultado"
           wrapText="true"
           style="-fx-font-size: 14px; -fx-text-fill: #1f4b73;"/>
</VBox>
